# ezPosBackend environment configuration.
# Copy to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string (required).
DATABASE_URL=postgresql://user:password@localhost:5432/ezpos

# HS256 secret used to sign access tokens (required).
# Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Server-side policy overrides (optional; defaults shown).
TRIAL_DAYS=14
TRIAL_PLAN_SLUG=free-trial
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Set to "production" in production (enables Secure cookies).
NODE_ENV=development

# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# HTTP port for the backend (optional; defaults to 3000).
PORT=3000
